# ============================================================================
# Kestrel KYC — Environment configuration
# Copy to .env.local and fill in real values:  cp .env.example .env.local
# docker-compose reads .env.local (see env_file in docker-compose.yml).
# ============================================================================

# ---- Core infrastructure ---------------------------------------------------
# Inside docker-compose, hosts are the service names (postgres/redis/...).
# For host-machine tooling, swap the host for localhost.
DATABASE_URL=postgresql://kestrel:kestrel_dev_password@postgres:5432/kestrel_kyc
# 32-byte key, base64-encoded, used for AES-256-GCM PII encryption in the gateway.
# Generate: openssl rand -base64 32
DATABASE_ENCRYPT_KEY=ZHVtbXktMzItYnl0ZS1iYXNlNjQta2V5LXJlcGxhY2VtZQ==
REDIS_URL=redis://redis:6379
RABBITMQ_URL=amqp://kestrel:kestrel_dev_password@rabbitmq:5672

# ---- Temporal --------------------------------------------------------------
TEMPORAL_ADDRESS=temporal:7233
TEMPORAL_NAMESPACE=default

# ---- JWT (session tokens) --------------------------------------------------
JWT_PRIVATE_KEY_PATH=./keys/private.pem
JWT_PUBLIC_KEY_PATH=./keys/public.pem

# ---- AWS / S3 --------------------------------------------------------------
AWS_REGION=ap-south-1
AWS_S3_BUCKET=kestrel-kyc-documents
AWS_S3_AUDIT_BUCKET=kestrel-kyc-audit-logs
AWS_KMS_KEY_ID=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# ---- Third-party providers -------------------------------------------------
# Onfido (document + biometric verification)
ONFIDO_API_TOKEN=api_sandbox.replace-me
ONFIDO_BASE_URL=https://api.eu.onfido.com/v3.6
# ComplyAdvantage (AML / sanctions / PEP screening)
COMPLY_ADVANTAGE_KEY=replace-me
COMPLY_ADVANTAGE_URL=https://api.complyadvantage.com
# MaxMind (IP risk / geolocation)
MAXMIND_ACCOUNT_ID=replace-me
MAXMIND_LICENSE_KEY=replace-me
# Twilio (SMS)
TWILIO_SID=replace-me
TWILIO_TOKEN=replace-me
TWILIO_FROM=+10000000000
# SendGrid (email)
SENDGRID_API_KEY=replace-me
SENDGRID_FROM=no-reply@kestrel.lk

# ---- Compliance & security -------------------------------------------------
COMPLIANCE_EMAIL=compliance@yourdomain.com
# HMAC secret used to sign outbound webhooks (X-Kestrel-Signature).
WEBHOOK_SECRET=replace-with-random-secret

# ---- Service ports ---------------------------------------------------------
GATEWAY_PORT=8080
ORCHESTRATOR_PORT=3001
DOCUMENT_PORT=8001
BIOMETRIC_PORT=8002
AML_PORT=3002
RISK_PORT=8003
AUDIT_PORT=8004
NOTIFICATION_PORT=3003

# ---- Inter-service URLs (compose DNS) --------------------------------------
ORCHESTRATOR_URL=http://orchestrator:3001
DOCUMENT_URL=http://document:8001
BIOMETRIC_URL=http://biometric:8002
AML_URL=http://aml:3002
RISK_URL=http://risk:8003
IP_RISK_URL=http://risk:8003
AUDIT_URL=http://audit:8004
NOTIFICATION_URL=http://notification:3003

# ---- Runtime ---------------------------------------------------------------
LOG_LEVEL=debug
NODE_ENV=development
