# ============================================================================
# Kestrel KYC — .gitignore
# ============================================================================

# ---- 1. Credentials & secrets ----------------------------------------------
.env
.env.local
.env.production
.env.staging
.env.*.local
!.env.example

keys/*.pem
keys/*.key
*.pem
*.p12
*.pfx
*_rsa
# Public keys aren't secret — keep them trackable even though they match *_rsa.
!*_rsa.pub

terraform.tfvars
infra/terraform/terraform.tfvars
*.tfvars
!*.tfvars.example

# ---- 2. Go ------------------------------------------------------------------
services/*/bin/
services/*/*.exe
services/*/*.test
services/*/coverage.out
services/*/vendor/

# ---- 3. Node.js / TypeScript -------------------------------------------------
node_modules/
sdk/javascript/dist/
services/*/dist/
services/*/.next/
npm-debug.log*
yarn-error.log*
*.tsbuildinfo
.npm/

# ---- 4. Python ----------------------------------------------------------------
__pycache__/
*.pyc
*.pyo
.venv/
venv/
services/*/.venv/
services/*/venv/
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
htmlcov/

# ---- 5. Terraform -------------------------------------------------------------
infra/terraform/.terraform/
infra/terraform/*.tfstate
infra/terraform/*.tfstate.backup
infra/terraform/*.tfstate.*
# .terraform.lock.hcl is intentionally tracked (pins provider versions for
# reproducible builds) — do not ignore it.

# ---- 6. Docker ------------------------------------------------------------------
.docker/
docker-compose.override.yml

# ---- 7. IDE / OS -----------------------------------------------------------------
.DS_Store
.idea/
.vscode/*
!.vscode/extensions.json
*.swp
*.swo
Thumbs.db

# ---- 8. Test artifacts -------------------------------------------------------------
coverage/
test-results/
*.cover
